# Шаблон .env. Сам .env в репозиторий не попадает (.gitignore).
# Создать: python3 solution/init_env.py — скопирует шаблон и подставит случайные пароли
# вместо <generate>. Существующий .env скрипт не трогает.

# Доступ к MariaDB на локальном стенде: пароль задан стендом задания.
MARIADB_ROOT_PASSWORD=root_pass

# ClickHouse (хранилище решения). В проде значения приходят из менеджера секретов.
CLICKHOUSE_ADMIN_USER=admin
CLICKHOUSE_ADMIN_PASSWORD=<generate>
CLICKHOUSE_LOADER_USER=loader
CLICKHOUSE_LOADER_PASSWORD=<generate>
CLICKHOUSE_ANALYST_USER=analyst
CLICKHOUSE_ANALYST_PASSWORD=<generate>

# Airflow: пароль базы метаданных (Postgres).
AIRFLOW_DB_PASSWORD=<generate>

# uid:gid контейнера pipeline, если у вас на хосте не 1000:1000 (иначе выгрузка в results/ упадёт по правам).
# PIPELINE_USER=1000:1000
